{
  "id": "./",
  "name": "منصة عائلة الناصر",
  "short_name": "الناصر",
  "description": "شجرة العائلة وأنسابها · لأفراد عائلة الناصر",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./?src=app",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#10182A",
  "theme_color": "#10182A",
  "icons": [
    {
      "src": "icon-v3-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-v3-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "maskable-v3-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://zainlukoil-hash.github.io/alnasser-family-/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false
}